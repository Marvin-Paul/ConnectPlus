generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum ReactionType {
  LIKE
  LOVE
  CELEBRATE
  INSIGHTFUL
  CURIOUS
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum NotificationType {
  REACTION
  COMMENT
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  JOB_ALERT
  MENTION
  SYSTEM
  REPOST
}

enum JobApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

model User {
  id            String          @id @default(cuid())
  name          String?         // Full Name
  email         String          @unique
  username      String?         @unique
  phone         String?         @unique // Phone Number
  passwordHash  String
  verificationToken String?     // For email verification
  firstName     String?
  lastName      String?
  headline      String?
  bio           String?
  location      String?
  avatarUrl     String?
  bannerUrl     String?
  pronouns      String?
  pronunciationUrl String?
  isHiring      Boolean         @default(false)
  isPremium     Boolean         @default(false)
  verified      Boolean         @default(false)
  gitlabUsername String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  experiences   Experience[]
  educations    Education[]
  skills        Skill[]
  posts         Post[]
  comments      Comment[]
  reactions     Reaction[]
  reposts       Repost[]
  jobsPosted    Job[]           @relation("JobPoster")
  applications  JobApplication[]

  featuredItems  FeaturedItem[]
  certifications Certification[]
  projects       Project[]
  volunteering   VolunteerExperience[]
  honors         Honor[]

  recommendationsReceived Recommendation[] @relation("ReceivedRecommendations")
  recommendationsGiven    Recommendation[] @relation("GivenRecommendations")

  sentConnections     Connection[] @relation("SentConnections")
  receivedConnections Connection[] @relation("ReceivedConnections")

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  notifications Notification[] @relation("UserNotifications")
  
  conversations ConversationParticipant[]
  messages      Message[]
}

model Experience {
  id          String    @id @default(cuid())
  userId      String
  title       String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  isCurrent   Boolean   @default(false)
  isElite     Boolean   @default(false) // For high-impact roles in the UI
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Education {
  id            String   @id @default(cuid())
  userId        String
  school        String
  degree        String?
  fieldOfStudy  String?
  startDate     DateTime?
  endDate       DateTime?
  grade         String?
  activities    String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Skill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model FeaturedItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  linkUrl     String?
  imageUrl    String?
  type        String   @default("LINK") // ARTICLE, LINK, PROJECT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Recommendation {
  id          String   @id @default(cuid())
  authorId    String
  receiverId  String
  content     String
  relationship String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User @relation("GivenRecommendations", fields: [authorId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRecommendations", fields: [receiverId], references: [id], onDelete: Cascade)
  
  @@index([receiverId])
}

model Certification {
  id             String    @id @default(cuid())
  userId         String
  name           String
  issuingOrg     String
  issueDate      DateTime?
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  projectUrl  String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VolunteerExperience {
  id           String    @id @default(cuid())
  userId       String
  organization String
  role         String
  cause        String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Honor {
  id          String    @id @default(cuid())
  userId      String
  title       String
  issuer      String
  issueDate   DateTime?
  description String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Connection {
  id           String           @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       ConnectionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  requester User @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedConnections", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Post {
  id         String    @id @default(cuid())
  authorId   String
  content    String
  imageUrl   String?
  type       String    @default("POST") // POST, ARTICLE
  title      String?   // For Articles
  tags       String[]  // Array of tags
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]
  reactions  Reaction[]
  reposts    Repost[]   @relation("OriginalPost")
  repostedBy Repost[]   @relation("RepostedPost")

  // Event specific fields (if Post can be an event)
  isEvent       Boolean    @default(false)
  eventDate     DateTime?
  eventLocation String?
  attendeeCount Int        @default(0)

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model Reaction {
  id        String       @id @default(cuid())
  type      ReactionType
  userId    String
  postId    String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Repost {
  id             String   @id @default(cuid())
  userId         String
  originalPostId String
  repostPostId   String?  @unique // The new post created by reposting
  createdAt      DateTime @default(now())

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPost Post @relation("OriginalPost", fields: [originalPostId], references: [id], onDelete: Cascade)
  repostPost   Post? @relation("RepostedPost", fields: [repostPostId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([originalPostId])
}

model Comment {
  id              String    @id @default(cuid())
  postId          String
  authorId        String
  parentCommentId String?
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  content     String
  sourceId    String?          // ID of related entity (Post, User, etc)
  sourceType  String?          // e.g. "POST", "USER"
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Job {
  id               String           @id @default(cuid())
  postedById       String
  title            String
  company          String
  location         String
  employmentType   EmploymentType
  description      String
  isRemote         Boolean          @default(false)
  salaryMin        Int?
  salaryMax        Int?
  currencyCode     String?          @default("USD")
  applicationUrl   String?
  matchPercentage  Int?             @default(0) // Mock logic for UI
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  postedBy     User             @relation("JobPoster", fields: [postedById], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([postedById, createdAt])
  @@index([isActive, createdAt])
  @@index([location, employmentType])
}

model JobApplication {
  id                    String               @id @default(cuid())
  jobId                 String
  applicantId           String
  status                JobApplicationStatus @default(SUBMITTED)
  coverLetter           String?
  profileSnapshotJson   Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([applicantId, status])
}
